# Declared offline profile: a real source target, with no host/prebuilt dependency.
get_property(corpus_zlib_ready GLOBAL PROPERTY CORPUS_ZLIB_READY)
if(NOT corpus_zlib_ready)
  set_property(GLOBAL PROPERTY CORPUS_ZLIB_READY TRUE)
  function(corpus_add_pinned_zlib)
    set(SKIP_INSTALL_ALL ON)
    set(ZLIB_BUILD_EXAMPLES OFF CACHE BOOL "Disable dependency examples" FORCE)
    add_subdirectory("${CMAKE_SOURCE_DIR}/../zlib-native" "${CMAKE_BINARY_DIR}/zlib-native" EXCLUDE_FROM_ALL)
  endfunction()
  corpus_add_pinned_zlib()
  add_library(ZLIB::ZLIB INTERFACE IMPORTED GLOBAL)
  set_property(TARGET ZLIB::ZLIB PROPERTY INTERFACE_LINK_LIBRARIES zlibstatic)
endif()
list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}/cmake")
